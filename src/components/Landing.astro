---
// The scroll landing (Video Lab v2) is a self-contained HTML document kept as-is in src/landing/landing.html.
// This wrapper fills the per-language head (lang, title, description, canonical, hreflang) and serves it raw.
import raw from '../landing/landing.html?raw';
interface Props { lang: 'en' | 'es'; }
const { lang } = Astro.props;
const META = {
  en: { title: 'raw2top · AI design studio',
        desc: 'AI design studio. Scroll landings, brand videos, product videos and AI agents. Made frame by frame.' },
  es: { title: 'raw2top · Estudio de diseño con IA',
        desc: 'Estudio de diseño con IA. Landings con scroll, vídeos de marca, vídeos de producto y agentes de IA. Hechos fotograma a fotograma.' },
}[lang];
const site = Astro.site!.href.replace(/\/$/, '');
const url = { en: `${site}/`, es: `${site}/es/` };
// Share card (X, WhatsApp, LinkedIn…): same 1280×720 plate as Base.astro uses for every other page.
const img = `${site}/landing/assets/plate-01.jpg`;
const imgAlt = lang === 'es'
  ? 'Personaje de raw2top con capucha y gafas turquesa delante de un cerezo en flor'
  : 'The raw2top character in a hoodie and teal goggles in front of a cherry blossom tree';
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');
const head = [
  `<link rel="canonical" href="${url[lang]}">`,
  `<link rel="alternate" hreflang="en" href="${url.en}">`,
  `<link rel="alternate" hreflang="es" href="${url.es}">`,
  `<link rel="alternate" hreflang="x-default" href="${url.en}">`,
  `<meta name="theme-color" content="#0a0b0f">`,
  `<meta property="og:title" content="${esc(META.title)}">`,
  `<meta property="og:description" content="${esc(META.desc)}">`,
  `<meta property="og:type" content="website">`,
  `<meta property="og:url" content="${url[lang]}">`,
  `<meta property="og:image" content="${img}">`,
  `<meta property="og:image:type" content="image/jpeg">`,
  `<meta property="og:image:width" content="1280">`,
  `<meta property="og:image:height" content="720">`,
  `<meta property="og:image:alt" content="${esc(imgAlt)}">`,
  `<meta property="og:locale" content="${lang === 'es' ? 'es_ES' : 'en_US'}">`,
  `<meta name="twitter:card" content="summary_large_image">`,
  `<meta name="twitter:title" content="${esc(META.title)}">`,
  `<meta name="twitter:description" content="${esc(META.desc)}">`,
  `<meta name="twitter:image" content="${img}">`,
  `<meta name="twitter:image:alt" content="${esc(imgAlt)}">`,
].join('\n');
// first-scene pill text in the HTML for this page's language (it is the LCP text), taken from the landing's own DICT
// so there is one source; the JS i18n later writes the same string (no visible change)
const pill = (() => { const block = raw.slice(raw.indexOf(`\n ${lang}:{`)); const m = block.match(/'s1\.pill':'([^']*)'/);
  if (raw.indexOf(`\n ${lang}:{`) < 0 || !m) throw new Error(`landing.html: s1.pill for ${lang} not found`);
  return m[1].replace(/&(?![a-z]+;|#\d+;)/g, '&amp;'); })();
const html = raw
  .replace('%%S1PILL%%', pill)
  .replace('%%LANG%%', lang)
  .replace('%%TITLE%%', esc(META.title))
  .replace('%%DESC%%', esc(META.desc))
  .replace('%%HEADMETA%%', head)
  .replaceAll('%%MAIL%%', lang === 'es' ? 'hola@raw2top.com' : 'hello@raw2top.com');
---
<Fragment set:html={html} />

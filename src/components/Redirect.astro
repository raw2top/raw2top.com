---
// Static redirect for a moved page (GitHub Pages has no server redirects).
// JS keeps the #hash and ?query (e.g. /bots/#tcg-scout -> /drops/#tcg-scout); meta refresh is the no-JS fallback.
interface Props { to: string; lang: 'en' | 'es'; }
const { to, lang } = Astro.props;
const canonical = new URL(to, Astro.site).href;
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <title>Drops · raw2top</title>
  <meta name="robots" content="noindex" />
  <link rel="canonical" href={canonical} />
  <script is:inline define:vars={{ to }}>location.replace(to + location.search + location.hash);</script>
  <meta http-equiv="refresh" content={`0; url=${to}`} />
</head>
<body>
  <p><a href={to}>raw2top · Drops</a></p>
</body>
</html>

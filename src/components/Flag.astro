---
// small inline SVG flags for the language switcher (emoji flags do not render on Windows)
interface Props { lang: 'en' | 'es' }
const { lang } = Astro.props;
---
<span class="flag" aria-hidden="true">
  {lang === 'en' ? (
    <svg viewBox="0 0 38 20" preserveAspectRatio="xMidYMid slice" focusable="false"><path fill="#B22234" d="M0 0h38v20H0z"/><path fill="#fff" d="M0 1.538h38v1.538H0zM0 4.615h38v1.538H0zM0 7.692h38v1.538H0zM0 10.769h38v1.538H0zM0 13.846h38v1.538H0zM0 16.923h38v1.538H0z"/><path fill="#3C3B6E" d="M0 0h15.2v10.769H0z"/><g fill="#fff"><circle cx="1.6" cy="1.5" r=".55"/><circle cx="4.6" cy="1.5" r=".55"/><circle cx="7.6" cy="1.5" r=".55"/><circle cx="10.6" cy="1.5" r=".55"/><circle cx="13.6" cy="1.5" r=".55"/><circle cx="3.1" cy="4.1" r=".55"/><circle cx="6.1" cy="4.1" r=".55"/><circle cx="9.1" cy="4.1" r=".55"/><circle cx="12.1" cy="4.1" r=".55"/><circle cx="1.6" cy="6.7" r=".55"/><circle cx="4.6" cy="6.7" r=".55"/><circle cx="7.6" cy="6.7" r=".55"/><circle cx="10.6" cy="6.7" r=".55"/><circle cx="13.6" cy="6.7" r=".55"/><circle cx="3.1" cy="9.3" r=".55"/><circle cx="6.1" cy="9.3" r=".55"/><circle cx="9.1" cy="9.3" r=".55"/><circle cx="12.1" cy="9.3" r=".55"/></g></svg>
  ) : (
    <svg viewBox="0 0 30 20" preserveAspectRatio="xMidYMid slice" focusable="false"><path fill="#AA151B" d="M0 0h30v20H0z"/><path fill="#F1BF00" d="M0 5h30v10H0z"/></svg>
  )}
</span>

---
import '../styles/global.css';
import Flag from '../components/Flag.astro';
import { getLang, localize, unlocalize, languages, type Lang } from '../i18n/utils';
import { useT } from '../i18n/ui';
interface Props { title: string; description?: string; }
const lang: Lang = getLang(Astro.currentLocale);
const t = useT(lang);
const { title, description = t('meta.desc') } = Astro.props;
const fullTitle = title === 'home' ? t('meta.home') : `${title} · raw2top`;
const path = unlocalize(Astro.url.pathname);
const links = [
  { href: '/drops/', label: t('nav.drops') },
  { href: '/about/', label: t('nav.about') },
  { href: '/report/', label: t('nav.report') },
];
const canonical = new URL(localize(path, lang), Astro.site);
const alternates = (Object.keys(languages) as Lang[]).map((l) => ({ l, href: new URL(localize(path, l), Astro.site).href }));
const other: Lang = lang === 'en' ? 'es' : 'en';
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta name="theme-color" content="#0A0B0F" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />
  {alternates.map((a) => <link rel="alternate" hreflang={a.l} href={a.href} />)}
  <link rel="alternate" hreflang="x-default" href={alternates[0].href} />
</head>
<body>
  <a class="skip" href="#main">{t('skip')}</a>
  <div class="bg" aria-hidden="true"><div class="glow" id="glow"></div><div class="glow2"></div><div class="noise"></div></div>
  <header class="wrap nav">
    <a href={localize('/', lang)} class="logo" aria-label={t('nav.home')}>raw<b>2</b>top</a>
    <div class="right">
      <nav aria-label={t('nav.main')}>
        <ul>
          {links.map((l) => (
            <li><a href={localize(l.href, lang)} aria-current={path.startsWith(l.href) ? 'page' : undefined}>{l.label}</a></li>
          ))}
        </ul>
      </nav>
      <div class="lang" data-lang-dd>
        <button type="button" class="lang-btn" id="lang-btn" aria-haspopup="true" aria-expanded="false" aria-controls="lang-menu"
          aria-label={`${t('lang.switch')}: ${languages[lang]}`} title={languages[lang]}><Flag lang={lang} /><svg class="caret" viewBox="0 0 10 6" aria-hidden="true" focusable="false"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
        <ul class="lang-menu" id="lang-menu" role="menu" aria-labelledby="lang-btn" hidden>
          {(['en', 'es'] as Lang[]).map((l) => (
            <li role="none"><a role="menuitem" tabindex="-1" href={localize(path, l)} hreflang={l} lang={l} title={languages[l]} aria-label={languages[l]} aria-current={l === lang ? 'true' : undefined}><Flag lang={l} /></a></li>
          ))}
        </ul>
      </div>
    </div>
  </header>
  <main id="main"><slot /></main>
  <footer class="wrap foot">
    <div>
      <span class="logo small">raw<b>2</b>top</span>
      <p class="muted">{t('foot.tag')}</p>
    </div>
    <ul>
      <li><a href={localize('/drops/', lang)}>{t('nav.drops')}</a></li>
      <li><a href={localize('/about/', lang)}>{t('nav.about')}</a></li>
      <li><a href={localize('/report/', lang)}>{t('foot.report')}</a></li>
    </ul>
    <p class="legal mono">{t('foot.legal')} © {new Date().getFullYear()} raw2top</p>
  </footer>
  <script>
    // Language dropdown: one flag button; tap/click/Enter opens a vertical menu of languages.
    document.querySelectorAll<HTMLElement>('[data-lang-dd]').forEach((dd) => {
      const btn = dd.querySelector<HTMLButtonElement>('.lang-btn')!;
      const menu = dd.querySelector<HTMLElement>('.lang-menu')!;
      const items = () => [...menu.querySelectorAll<HTMLElement>('[role=menuitem]')];
      const isOpen = () => btn.getAttribute('aria-expanded') === 'true';
      const open = (focus: 'current' | 'first' | 'last' | null) => {
        menu.hidden = false; btn.setAttribute('aria-expanded', 'true'); dd.classList.add('open');
        const it = items(); const cur = it.findIndex((a) => a.getAttribute('aria-current') === 'true');
        const k = focus === 'first' ? 0 : focus === 'last' ? it.length - 1 : Math.max(0, cur);
        if (focus) it[k]?.focus();
      };
      const close = (refocus = false) => {
        if (!isOpen()) return;
        menu.hidden = true; btn.setAttribute('aria-expanded', 'false'); dd.classList.remove('open');
        if (refocus) btn.focus();
      };
      btn.addEventListener('click', (e) => { e.stopPropagation(); isOpen() ? close() : open(e.detail === 0 ? 'current' : null); });
      btn.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown') { e.preventDefault(); open('current'); }
        else if (e.key === 'ArrowUp') { e.preventDefault(); open('last'); }
      });
      menu.addEventListener('keydown', (e) => {
        const it = items(); const i = it.indexOf(document.activeElement as HTMLElement);
        if (e.key === 'ArrowDown') { e.preventDefault(); it[(i + 1) % it.length].focus(); }
        else if (e.key === 'ArrowUp') { e.preventDefault(); it[(i - 1 + it.length) % it.length].focus(); }
        else if (e.key === 'Home') { e.preventDefault(); it[0].focus(); }
        else if (e.key === 'End') { e.preventDefault(); it[it.length - 1].focus(); }
        else if (e.key === 'Tab') close();
        else if (e.key === ' ') { e.preventDefault(); (document.activeElement as HTMLElement)?.click(); }
      });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && isOpen()) { e.preventDefault(); close(true); } });
      document.addEventListener('pointerdown', (e) => { if (isOpen() && !dd.contains(e.target as Node)) close(); });
      document.addEventListener('focusin', (e) => { if (isOpen() && !dd.contains(e.target as Node)) close(); });
      // remember the choice the same way the landing does
      items().forEach((a) => a.addEventListener('click', () => { try { localStorage.setItem('raw2top-lang', a.lang); } catch (_) {} }));
      window.addEventListener('pageshow', () => close());
    });
  </script>
  <script>
    // Slow cursor-follow glow + card edge light. Off for reduced motion and touch.
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const fine = window.matchMedia('(pointer: fine)').matches;
    if (!reduce && fine) {
      const glow = document.getElementById('glow');
      let raf = 0;
      window.addEventListener('pointermove', (e) => {
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(() => {
          glow?.style.setProperty('--gx', `${e.clientX - 450}px`);
          glow?.style.setProperty('--gy', `${e.clientY - 450}px`);
        });
      }, { passive: true });
      document.querySelectorAll<HTMLElement>('.card').forEach((c) => {
        c.addEventListener('pointermove', (e) => {
          const r = c.getBoundingClientRect();
          c.style.setProperty('--mx', `${e.clientX - r.left}px`);
          c.style.setProperty('--my', `${e.clientY - r.top}px`);
        });
      });
    }
  </script>
</body>
</html>
<style>
  .nav { display: flex; justify-content: space-between; align-items: center; height: 84px; position: relative; z-index: 20; }
  /* header logo: same as the landing's (raw<b>2</b>top, Space Grotesk 700, only the 2 in lime) */
  .nav .logo { font-family: var(--sans); font-weight: 700; letter-spacing: -.045em; font-size: clamp(17px, 1.4vw, 24px); color: var(--text); text-decoration: none; }
  .nav .logo b { color: var(--lime); }
  .nav .logo:hover { color: var(--text); }
  .logo { font-weight: 700; font-size: 20px; letter-spacing: -0.02em; text-decoration: none; color: var(--text); }
  .logo span { color: var(--lime); }
  /* footer logo: same mark as the header (raw<b>2</b>top, Space Grotesk 700, lime 2), a bit smaller */
  .foot .logo.small { font-family: var(--sans); font-weight: 700; letter-spacing: -.045em; font-size: 19px; }
  .foot .logo b { color: var(--lime); }
  .right { display: flex; align-items: center; gap: 26px; }
  .lang { position: relative; z-index: 60; }
  .lang-btn { display: inline-flex; align-items: center; gap: 7px; padding: 8px 11px 8px 10px; min-height: 36px; border: 1px solid var(--line); border-radius: 999px;
    background: rgba(18,20,27,.86); color: var(--muted); cursor: pointer; font: inherit; line-height: 0; -webkit-tap-highlight-color: transparent; transition: border-color .15s, color .15s; }
  .lang-btn:hover, .lang-btn:focus-visible, .lang.open .lang-btn { border-color: var(--lime); color: var(--lime); }
  .lang-btn:focus-visible { outline: 2px solid var(--lime); outline-offset: 2px; }
  .caret { width: 10px; height: 6px; transition: transform .15s; }
  .lang.open .caret { transform: rotate(180deg); }
  .lang-menu { position: absolute; top: calc(100% + 6px); right: 0; margin: 0; padding: 4px; list-style: none; display: flex; flex-direction: column; gap: 4px;
    border: 1px solid var(--line); border-radius: 18px; background: rgba(18,20,27,.96); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
    box-shadow: 0 12px 30px rgba(0,0,0,.5); }
  .lang-menu[hidden] { display: none; }
  .lang-menu a { display: flex; align-items: center; justify-content: center; min-width: 46px; min-height: 36px; padding: 8px 12px; border-radius: 999px; line-height: 0; text-decoration: none; opacity: .7; transition: opacity .15s, background .15s; }
  .lang-menu a:hover, .lang-menu a:focus-visible { opacity: 1; background: var(--panel-2); }
  .lang-menu a:focus-visible { outline: 2px solid var(--lime); outline-offset: 0; }
  .lang-menu a[aria-current='true'] { background: var(--lime); opacity: 1; }
  .lang :global(.flag) { display: block; width: 22px; height: 15px; border-radius: 3px; overflow: hidden; box-shadow: 0 0 0 1px rgba(255,255,255,.18); }
  .lang :global(.flag svg) { display: block; width: 100%; height: 100%; }
  nav ul { display: flex; gap: 28px; list-style: none; margin: 0; padding: 0; }
  nav a { color: var(--muted); text-decoration: none; font-size: 15px; padding: 6px 0; }
  nav a:hover, nav a[aria-current='page'] { color: var(--text); }
  nav a[aria-current='page'] { box-shadow: inset 0 -2px 0 var(--lime); }
  .foot { position: relative; z-index: 1; border-top: 1px solid var(--line); padding: 36px 0 44px; margin-top: 40px; display: grid; grid-template-columns: 1fr auto; gap: 20px 40px; }
  .foot p { font-size: 14px; margin-top: 6px; }
  .foot ul { list-style: none; margin: 0; padding: 0; display: flex; gap: 22px; font-size: 14px; }
  .foot ul a { color: var(--muted); }
  .legal { grid-column: 1 / -1; font-size: 12px; color: var(--muted); }
  @media (max-width: 600px) { nav ul { gap: 14px; } nav a { font-size: 14px; } .right { gap: 14px; } .foot { grid-template-columns: 1fr; } .foot ul { flex-wrap: wrap; } }
</style>

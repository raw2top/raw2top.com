---
import Base from '../layouts/Base.astro';
import { type Lang, localize } from '../i18n/utils';
import { Image } from 'astro:assets';
import avatar from '../assets/raw2top-avatar.jpg';
const X_URL = 'https://x.com/raw2top';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const c = {
  en: { title: 'About us', eyebrow: 'About us', founderH: 'About the founder', h: 'Hi there.', alt: "Sergio's avatar: illustrated hooded figure with green goggles",
    bio: "I'm Sergio Domínguez, an AI dev based in Spain and the person behind raw2top. With AI, I design frame-by-frame scroll landings, brand videos, product videos and AI agents. Every AI agent we publish comes with a public test card, so you know what it really does before you use it.", xLabel: 'Follow on X', 
    whyH: 'What raw2top is',
    why: 'raw2top is an AI design studio: frame-by-frame scroll landings, brand videos, product videos and AI agents. Our portfolio shows only our own work. Today it’s called AI; tomorrow, SI (superintelligence). We’re already building for that leap.',
    rulesH: 'House rules',
    rules: ['Only our own work in the portfolio.', 'Every result is a real run, with its date and app version.', 'If a test fails, the card says so.', 'Not affiliated with SpaceXSI.'],
    findH: 'Find us', report: 'Found a problem with one of our pieces?', reportCta: 'Report it',
    disc: '“Grok Bot” is mentioned only to describe compatibility. Not affiliated with SpaceXSI. © 2026 raw2top' },
  es: { title: 'Nosotros', eyebrow: 'Nosotros', founderH: 'Sobre el fundador', h: 'Hola.', alt: 'Avatar de Sergio: figura ilustrada con capucha y gafas verdes',
    bio: 'Soy Sergio Domínguez, dev de IA con base en España y la persona detrás de raw2top. Con IA diseño landings con scroll fotograma a fotograma, vídeos de marca, vídeos de producto y agentes de IA. Cada agente de IA que publicamos lleva su ficha de prueba pública, para que sepas lo que hace de verdad antes de usarlo.', xLabel: 'Síguenos en X', 
    whyH: 'Qué es raw2top',
    why: 'raw2top es un estudio de diseño con IA: landings con scroll, vídeos de marca y de producto, y agentes de IA. En el portfolio solo enseñamos trabajo propio. Hoy lo llamamos IA; mañana, SI (superinteligencia). Nosotros ya construimos para ese salto.',
    rulesH: 'Reglas de la casa',
    rules: ['Solo trabajo propio en el portfolio.', 'Cada resultado es una ejecución real, con fecha y versión de la app.', 'Si una prueba falla, la ficha lo dice.', 'Sin relación con SpaceXSI.'],
    findH: 'Dónde encontrarnos', report: '¿Has encontrado un problema en una de nuestras piezas?', reportCta: 'Avísanos',
    disc: '«Grok Bot» se menciona solo para indicar compatibilidad. Sin afiliación con SpaceXSI. © 2026 raw2top' },
}[lang];
---
<Base title={c.title}>
  <section class="wrap page">
    <p class="eyebrow">{c.eyebrow}</p>
    <h1>{c.whyH}</h1>
    <p class="lead">{c.why}</p>
    <div class="top">
      <Image src={avatar} alt={c.alt} width={200} height={200} densities={[1, 2]} class="photo" loading="eager" />
      <div>
        <h2 class="fh">{c.founderH}</h2>
        <p class="bio">{c.bio}</p>
        <p class="x"><a href={X_URL} rel="me noopener">@raw2top</a> <span class="muted">· {c.xLabel} ↗</span></p>
      </div>
    </div>
    <div class="cols">
      <div class="card"><h2>{c.rulesH}</h2><ul>{c.rules.map((r) => <li class="muted">{r}</li>)}</ul></div>
      <div class="card"><h2>{c.findH}</h2><p><a href={X_URL} rel="me noopener">x.com/raw2top ↗</a></p>
        <p class="muted rep">{c.report} <a href={localize('/report/', lang)}>{c.reportCta} →</a></p></div>
    </div>
    <p class="disc mono">{c.disc}</p>
  </section>
</Base>
<style>
  .page { padding-top: 40px; padding-bottom: 40px; }
  .lead { font-size: 21px; max-width: 720px; margin-bottom: 48px; }
  .fh { font-size: 26px; margin-bottom: 12px; }
  .top { display: grid; grid-template-columns: 200px 1fr; gap: 32px; align-items: center; }
  .photo { width: 200px; height: 200px; border-radius: 50%; border: 1px solid var(--line); box-shadow: 0 0 0 6px rgba(198,255,61,.08); }
  .bio { font-size: 19px; max-width: 640px; }
  .x { margin-top: 14px; font-family: var(--mono); font-size: 14px; }
  .x a { color: var(--lime); }
  h1 { font-size: clamp(40px, 6vw, 64px); margin: 8px 0 14px; }
  .cols { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px; margin-top: 48px; }
  .cols h2 { font-size: 20px; margin-bottom: 10px; }
  .cols ul { margin: 0; padding-left: 18px; display: grid; gap: 6px; }
  .rep { margin-top: 18px; font-size: 14px; }
  .disc { margin-top: 40px; font-size: 11px; line-height: 1.5; color: var(--muted); opacity: .75; }
  @media (max-width: 860px) { .cols { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { .top { grid-template-columns: 1fr; } .photo { width: 140px; height: 140px; } }
</style>

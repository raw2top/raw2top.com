const pad = (n: number) => String(n).padStart(2, '0');
const MON = { en: ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'], es: ['ene','feb','mar','abr','may','jun','jul','ago','sept','oct','nov','dic'] };
const fmtDate = (iso: string) => { const [y, m, d] = iso.split('-').map(Number); const mo = (MON as any)[lang][m - 1];
  return lang === 'es' ? `${d} ${mo} ${y}` : `${mo} ${d}, ${y}`; };
const total = Math.max(SLOTS, landing.bots.length);
const bots = landing.bots.map((b: any) => {
  const features: string[] = b.features[lang] ?? b.features.en;
  // features[0] is the games line ("Pokémon · Magic · One Piece · Lorcana & more"); the rest are the card's moves.
  const games = features[0].split(' · ').flatMap((g) => g.split(/ (?=(?:& more|y más)$)/));
  const tst = b.tested;
  // Stale = dated test older than STALE_DAYS, computed at build time (same rule as src/lib/bots.ts).
  const age = tst?.date ? (Date.now() - Date.parse(tst.date + 'T00:00:00Z')) / 86_400_000 : NaN;
  const status = tst ? (age > STALE_DAYS ? 'Tested-stale' : 'Tested') : 'Listed';
  return {
    ...b, games, moves: features.slice(1), status,
    statusLabel: t(`st.${status}` as any),
    fn: b.oneLiner[lang] ?? b.oneLiner.en,
    typeTag: dropTypeLabel(b.type, lang),
    role: b.role?.[lang] ?? b.role?.en, kind: b.kind?.[lang] ?? b.kind?.en,
    access: b.access?.[lang] ?? b.access?.en,
    serial: `RAW-0${b.number}`,
    testedOn: tst?.date ? fmtDate(tst.date) : null,
    app: tst?.appVersion ?? null,
    skills: (tst?.skills?.[lang] ?? tst?.skills?.en ?? null) as string[] | null,
    note: !tst ? t('back.note') : (tst.skills ? null : t('back.noteSkills')),
  };
});
const empty = Array.from({ length: Math.max(0, total - bots.length) }, (_, i) => pad(bots.length + i + 1));
const dot = (s: string) => (s === 'Tested' ? 'd-tested' : s === 'Tested-stale' ? 'd-stale' : 'd-listed');
---
<Base title={t('title')} description={t('desc')}>
  <script is:inline>if(!matchMedia('(prefers-reduced-motion: reduce)').matches)document.documentElement.classList.add('bp-intro');setTimeout(function(){document.documentElement.classList.remove('bp-intro')},4000)</script>
  <div class="bp" data-hint-pointer={t('hintPointer')} data-hint-touch={t('hintTouch')}>
    <section class="head bp-in">
      <div>
        <div class="lab m"><i></i><span>{t('lab', { n: pad(bots.length), total: pad(total) })}</span></div>
        <h1>{t('h1')}</h1>
        <p class="intro">{t('intro')}</p>
      </div>
      <div class="count m">
        <div class="pips" aria-hidden="true">{Array.from({ length: total }, (_, i) => <span class={i < bots.length ? 'on' : undefined}></span>)}</div>
        <span set:html={t('count', { n: bots.length, total })}></span>
      </div>
    </section>

    <h2 class="sr-only">{t('h1')}</h2>
    <div class="deck">
      {bots.map((b) => (
        <div id={b.slug} class="slot holo" tabindex="0" role="button" aria-roledescription="card" aria-pressed="false"
          aria-label={t('cardAl', { name: b.name, status: b.statusLabel })}
          data-al-front={t('cardAl', { name: b.name, status: b.statusLabel })} data-al-back={t('cardAlBack', { name: b.name })}>
          <div class="shadow"></div>
          <div class="card3d">
            <article class="face front" aria-hidden="false">
              <div class="ttl"><h3>{b.name}</h3><span class="badge"><i class={dot(b.status)}></i><span>{b.statusLabel}</span></span></div>
              <div class="art"><img src={b.cardImage ?? b.image} alt={t('imgAlt', { name: b.name })} width="720" height="720" decoding="async" />{b.typeTag && <span class="dtype">{b.typeTag}</span>}</div>
              {b.role && <div class="type"><span>{b.role}</span><b>{b.kind}</b></div>}
              <p class="fn">{b.fn}</p>
              <ul class="moves">{b.moves.map((m: string) => <li>{m}</li>)}</ul>
              <div class="cfoot"><span>{b.serial}</span><span class="wm">raw<b>2</b>top</span><span>{b.number} / {pad(total)} ↻</span></div>
              <div class="foil"></div><div class="sparkle"></div><div class="glare"></div>
            </article>
            <article class="face back" aria-hidden="true">
              <div class="bh"><div><div class="bl">{t('back.lab')}</div><h3>{b.name}</h3></div><span class="badge"><i class={dot(b.status)}></i><span>{b.statusLabel}</span></span></div>
              <dl>
                <dt>{t('back.tested')}</dt>{b.testedOn ? <dd><time datetime={b.tested.date}>{b.testedOn}</time></dd> : <dd class="pend">{t('pending')}</dd>}
                <dt>{t('back.app')}</dt>{b.app ? <dd>{b.app}</dd> : <dd class="pend">{t('pending')}</dd>}
                <dt>{t('back.skills')}</dt>{b.skills?.length ? <dd><button type="button" class="skb" aria-expanded="false" aria-controls={`sk-${b.slug}`} aria-label={t('back.seeAl', { n: b.skills.length })} tabindex="-1">{t('back.see')}</button></dd> : <dd class="pend">{t('pending')}</dd>}
                <dt>{t('back.access')}</dt>{b.access ? <dd>{b.access}</dd> : <dd class="pend">{t('pending')}</dd>}
              </dl>
              {b.note && <p class="note">{b.note}</p>}
              <div class="games"><span class="gl">{t('gamesL')}</span>{b.games.map((g: string) => <span>{g}</span>)}</div>
              <div class="btns">
                <a class="bbtn" href={b.templateUrl} target="_blank" rel="noopener" tabindex="-1">{t('back.open')}</a>
              </div>
              <div class="serial"><span>{b.serial}</span><span>{t('back.flip')}</span></div>
              {b.skills?.length && <div class="sbub" id={`sk-${b.slug}`} role="group" aria-labelledby={`skh-${b.slug}`} hidden><b id={`skh-${b.slug}`}>{t('back.skills')} · {b.skills.length}</b><ul>{b.skills.map((k: string) => <li>{k}</li>)}</ul></div>}
            </article>
          </div>
          <div class="fliphint m" aria-hidden="true" data-touch={t('fhTouch')} data-pointer={t('fhPointer')}>
            <svg class="sw" viewBox="0 0 48 16" focusable="false"><path class="trk" d="M6 8h36"/><path class="ah" d="M10 3.5 5 8l5 4.5M38 3.5 43 8l-5 4.5"/><circle class="dt" cx="24" cy="8" r="3.6"/></svg>
            <span>{t('fhTouch')}</span>
          </div>
        </div>
      ))}
      {empty.map((n) => (
        <div class="slot soon" role="note" aria-label={t('slotAl', { n })}>
          <div class="shadow"></div>
          <div class="card3d"><div class="face" aria-hidden="true">
            <span class="num">{t('slot', { n })}</span>
            <div class="emb"><span class="wm">raw<b>2</b>top</span></div>
            <span class="lablab"><i></i><span>{t('labNow')}</span></span>
            <span class="ser">RAW-0{n}</span>
          </div>
          {n % 2 === 0 ? <Fragment set:html={TAPE0} /> : <Fragment set:html={TAPE1} />}
          </div>
        </div>
      ))}
    </div>
    {empty.length > 0 && <p class="follow bp-in"><a class="xf m" href="https://x.com/raw2top" target="_blank" rel="noopener">{t('follow')} <span aria-hidden="true">↗</span></a></p>}
    <p class="hint m bp-in" aria-hidden="true">{t('hintPointer')}</p>

    <div class="legend m bp-in" role="group" aria-label={t('leg.status')}>
      <span class="leg-h">{t('leg.status')}:</span>
      <span class="chip"><i class="dot d-tested"></i><b>{t('st.Tested')}</b><span>{t('leg.tested')}</span></span>
      <span class="chip"><i class="dot d-stale"></i><b>{t('st.Tested-stale')}</b><span>{t('leg.stale')}</span></span>
      <span class="chip"><i class="dot d-listed"></i><b>{t('st.Listed')}</b><span>{t('leg.listed')}</span></span>
    </div>
  </div>
</Base>

<style is:global>
/* raw2top · caution tape overlay for coming-soon cards (one wrapped strip per card).
   <svg class="tape"> sits on top of the card, same box as the card (inset:0), and paints ~4% of the
   card width OUTSIDE the left/right edges (the fold around the edge). No ancestor between the svg and
   the card's outer box may have overflow:hidden / clip-path / contain:paint, or the fold gets cut. */
.tape{position:absolute;inset:0;width:100%;height:100%;overflow:visible;pointer-events:none;z-index:2;
  font-family:'Space Grotesk','Arial Narrow',Arial,sans-serif;font-weight:700;
  -webkit-user-select:none;user-select:none}
/* language: EN by default; ES when the svg inherits lang="es" (e.g. <html lang="es">).
   data-lang="en|es" on the svg forces one. Only display toggles, no animation. */
.tape .tape-es{display:none}
.tape:lang(es) .tape-es{display:inline}
.tape:lang(es) .tape-en{display:none}
.tape[data-lang="en"] .tape-en{display:inline}
.tape[data-lang="en"] .tape-es{display:none}
.tape[data-lang="es"] .tape-es{display:inline}
.tape[data-lang="es"] .tape-en{display:none}
/* raster/standalone fallback: <img class="tape-img tape-img--landing|--drops"> instead of the inline svg */
.tape-img{position:absolute;pointer-events:none;z-index:2;max-width:none;-webkit-user-select:none;user-select:none}
.tape-img--landing{inset:-4.5% -6%;width:112%;height:109%}
.tape-img--drops{inset:-4.2955% -6%;width:112%;height:108.591%}
</style>
<style>

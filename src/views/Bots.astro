/* first-load flip hint over the bot card: faint watermark pill, fades in and out once (~2.4 s), never blocks the card */
.fliphint{position:absolute;left:50%;top:40%;z-index:5;display:flex;align-items:center;gap:10px;padding:9px 15px 9px 12px;border-radius:999px;
  background:rgba(10,11,15,.52);border:1px solid rgba(198,255,61,.22);color:rgba(242,243,247,.86);font-size:11px;letter-spacing:.12em;white-space:nowrap;
